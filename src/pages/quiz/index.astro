---
import '../../styles/quiz.css';
import Base from '../../layouts/Base.astro';
import Livro from '../../components/livro/Livro.astro';
import { getQuestoes } from '../../lib/conteudo/quiz';
import { rotas } from '../../lib/rotas';

const questoes = await getQuestoes();
---
<Base titulo="Quiz" descricao="Quiz e Desafio de IPv6, com questões sorteadas, feedback e revisão no manual.">
  <Livro chave="quiz">
    <p class="chapeu">Apêndice B · Avaliar</p>
    <h1 class="titulo-secao">Quiz</h1>
    <div class="quiz" data-quiz>
      <section data-tela="inicio" aria-label="Escolher modo">
        <p class="quiz__intro">Escolha como quer praticar. O Quiz não tem tempo; o Desafio tem três dificuldades e tempo por questão.</p>
        <div class="quiz__modos">
          <article class="quiz__modo">
            <h2>Quiz</h2>
            <p>15 questões sorteadas de todas as partes, com feedback e explicação depois de cada resposta.</p>
            <button type="button" class="botao-principal" data-iniciar="quiz">Começar Quiz</button>
            <p class="quiz__melhor" data-melhor="quiz"></p>
          </article>
          <article class="quiz__modo">
            <h2>Desafio</h2>
            <p>Escolha uma dificuldade e responda contra o relógio.</p>
            <div class="quiz__dificuldades">
              <label><input type="radio" name="dificuldade" value="facil" checked /> Fácil <span>10 · 45 s</span></label>
              <label><input type="radio" name="dificuldade" value="medio" /> Médio <span>15 · 30 s</span></label>
              <label><input type="radio" name="dificuldade" value="dificil" /> Difícil <span>20 · 20 s</span></label>
            </div>
            <button type="button" class="botao-principal" data-iniciar="desafio">Escolher dificuldade</button>
            <p class="quiz__melhor" data-melhor="desafio-facil"></p>
            <p class="quiz__melhor" data-melhor="desafio-medio"></p>
            <p class="quiz__melhor" data-melhor="desafio-dificil"></p>
          </article>
        </div>
        <button type="button" class="botao-texto" data-limpar hidden>Limpar melhores resultados</button>
      </section>

      <section data-tela="regras" hidden aria-label="Regras do desafio">
        <p class="chapeu">Modo Desafio</p>
        <h2 data-regras-titulo></h2>
        <ul class="quiz__regras" data-regras></ul>
        <button type="button" class="botao-principal" data-comecar-desafio>Começar</button>
        <button type="button" class="botao-texto" data-voltar-inicio>Trocar de modo</button>
      </section>

      <section data-tela="questao" hidden aria-label="Questão">
        <div class="quiz__topo">
          <p class="quiz__contador" data-contador></p>
          <span class="barra quiz__barra" aria-hidden="true"><span data-barra></span></span>
          <button type="button" class="botao-texto quiz__encerrar" data-encerrar hidden>Encerrar</button>
        </div>
        <div class="quiz__enunciado-linha">
          <h2 class="quiz__enunciado" data-enunciado tabindex="-1"></h2>
          <div class="cronometro" data-cronometro hidden aria-label="Tempo restante">
            <svg viewBox="0 0 44 44" aria-hidden="true"><circle class="cronometro__trilho" cx="22" cy="22" r="19" /><circle class="cronometro__anel" data-anel cx="22" cy="22" r="19" /></svg>
            <span data-segundos>45</span>
          </div>
        </div>
        <ol class="quiz__alternativas" data-alternativas></ol>
        <div class="quiz__retorno" data-feedback aria-live="polite"></div>
        <div class="quiz__acoes"><button type="button" class="botao-principal" data-avancar hidden>Próxima questão</button></div>
        <p class="quiz__dica">Dica: use as teclas A, B, C e D para responder.</p>
      </section>
      <section class="res" data-tela="resultado" hidden tabindex="-1" aria-label="Resultado"></section>
    </div>
  </Livro>
</Base>

<script type="application/json" id="dados-quiz" set:html={JSON.stringify({ questoes, urlQuiz: rotas.quiz, urlManual: rotas.manual }).replace(/</g, '\\u003c')} />
<script>
  import { iniciarQuiz } from '../../scripts/quiz';
  document.addEventListener('astro:page-load', iniciarQuiz);
</script>
