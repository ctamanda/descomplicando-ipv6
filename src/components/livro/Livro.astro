---
/**
 * O livro aberto sobre a mesa. Toda página do site (menos a capa) é uma página
 * dele: o conteúdo entra pelo slot; o slot "fim" aparece antes de Anterior/Próxima.
 * Anterior, Próxima, a espessura das folhas e a aba ativa saem da ordem do livro
 * (lib/conteudo/livro.ts), pela `chave` da página.
 */
import '../../styles/prosa.css';
import '../../styles/livro.css';
import Icone from '../ui/Icone.astro';
import Abas from './Abas.astro';
import Leitura from './Leitura.astro';
import { getPaginaDoLivro, type Destino } from '../../lib/conteudo/livro';
import { rotas } from '../../lib/rotas';

interface Props {
  /** chave da página na ordem do livro: "sumario", "parte-3", "3.5", "quiz"... */
  chave: string;
  /** rótulo curto na barra de páginas (padrão: o da ordem do livro) */
  rotulo?: string;
  /** cabeçalho corrente no alto das páginas, como num livro impresso */
  cabecaEsq?: string;
  cabecaDir?: string;
  anterior?: Destino;
  proxima?: Destino;
}
const props = Astro.props;
const livro = await getPaginaDoLivro(props.chave);
const rotulo = props.rotulo ?? livro.pagina.rotulo;
const anterior = props.anterior ?? livro.anterior;
const proxima = props.proxima ?? livro.proxima;
const cabecaEsq = props.cabecaEsq ?? 'Descomplicando o IPv6';
const cabecaDir = props.cabecaDir ?? livro.pagina.titulo;

const PILHA = 9; // px, espessura máxima das folhas de cada lado
const pilhas = `--pilha-esq: ${Math.round(livro.progresso * PILHA) + 2}px; --pilha-dir: ${Math.round((1 - livro.progresso) * PILHA) + 2}px`;
// Ordem das páginas, para o script saber para que lado virar (a capa vem antes de tudo)
const ordem = [rotas.inicio, ...livro.hrefs];
---
<Leitura>
  <div class="mesa">
    <article
      class="livro"
      transition:name="livro-pagina"
      transition:animation="initial"
      data-livro
      style={pilhas}
      data-numero={rotulo}
      data-indice={livro.indice + 1}
      data-parte={livro.pagina.chave.match(/^(\d+)\./)?.[1]}
      data-anterior={anterior.href}
      data-anterior-titulo={anterior.titulo}
      data-proxima={proxima.href}
      data-proxima-titulo={proxima.titulo}
    >
      <span class="livro__cabeca livro__cabeca--esq" aria-hidden="true">{cabecaEsq}</span>
      <span class="livro__cabeca livro__cabeca--dir" aria-hidden="true">{cabecaDir}</span>
      <div class="livro__texto" data-texto>
        <slot />
        <footer class="fim-secao">
          <slot name="fim" />
          <nav class="vizinhos" aria-label="Navegação entre páginas do livro">
            <a href={anterior.href}><span>{anterior.rotulo}</span>{anterior.titulo}</a>
            <a class="vizinhos__proxima" href={proxima.href}><span>{proxima.rotulo}</span>{proxima.titulo}</a>
          </nav>
        </footer>
      </div>
      <span class="livro__pilha livro__pilha--esq" aria-hidden="true"></span>
      <span class="livro__pilha livro__pilha--dir" aria-hidden="true"></span>
      <span class="livro__num livro__num--esq" data-num-esq aria-hidden="true"></span>
      <span class="livro__num livro__num--dir" data-num-dir aria-hidden="true"></span>
      <!-- Cantos da página: clicar vira a folha (o teclado usa as setas da barra) -->
      <button class="livro__canto livro__canto--ant" type="button" data-canto="anterior" tabindex="-1" aria-hidden="true"></button>
      <button class="livro__canto livro__canto--prox" type="button" data-canto="proxima" tabindex="-1" aria-hidden="true"></button>
      <Abas atual={livro.pagina.aba} />
    </article>
  </div>

  <div class="controles" data-controles>
    <button class="controles__sumario" type="button" data-abrir-gaveta aria-controls="gaveta" aria-expanded="false">
      <Icone nome="menu" />
      <span>Sumário</span>
    </button>
    <p class="controles__status" data-status aria-live="polite">
      <span class="controles__parte" data-status-parte hidden></span>
      <strong data-status-secao>{rotulo}</strong>
      <span class="controles__sep"> · </span>
      <span data-status-paginas>Pág. 1</span>
    </p>
    <input class="controles__regua" type="range" min="1" max="1" value="1" step="1" data-regua aria-label="Página" />
    <output class="controles__balao" data-regua-tooltip hidden aria-hidden="true"></output>
    <div class="controles__setas">
      <button class="botao-icone" type="button" data-virar="anterior" aria-label="Página anterior"><Icone nome="anterior" /></button>
      <button class="botao-icone" type="button" data-virar="proxima" aria-label="Próxima página"><Icone nome="proxima" /></button>
    </div>
  </div>
</Leitura>

<script type="application/json" id="ordem-livro" set:html={JSON.stringify(ordem)} />

<script>
  import { iniciarLivro } from '../../scripts/livro';
  // after-swap: diagrama a página nova antes de ela aparecer na transição (sem pulos)
  document.addEventListener('astro:after-swap', () => iniciarLivro());
  document.addEventListener('astro:page-load', () => iniciarLivro());

  let fecharBalaoAberto: ((devolverFoco?: boolean) => void) | null = null;

  document.addEventListener('click', (evento) => {
    const link = (evento.target as Element).closest<HTMLButtonElement>('.termo');
    const aberto = document.querySelector<HTMLElement>('[data-balao-glossario]');
    if (aberto && (!link || aberto.dataset.termo !== link.dataset.glossarioHref)) {
      fecharBalaoAberto?.();
    }
    if (!link || evento.defaultPrevented) return;

    evento.preventDefault();
    const definicao = link.dataset.definicao ?? link.title;
    if (!definicao) return;
    if (aberto) {
      fecharBalaoAberto?.();
      return;
    }

    const href = link.dataset.glossarioHref;
    if (!href) return;
    const balao = document.createElement('div');
    balao.dataset.balaoGlossario = '';
    balao.dataset.termo = href;
    balao.className = 'balao-glossario';
    balao.setAttribute('role', 'dialog');
    balao.setAttribute('aria-label', 'Definição do termo');
    balao.innerHTML = '<strong></strong><p></p><a>Ver no glossário</a>';
    balao.querySelector<HTMLAnchorElement>('a')!.href = href;
    balao.querySelector('strong')!.textContent = link.textContent?.trim() ?? '';
    balao.querySelector('p')!.textContent = definicao;
    link.dataset.termoAberto = href;
    document.body.append(balao);

    const reposicionar = () => {
      const rect = link.getBoundingClientRect();
      const folha = document.querySelector<HTMLElement>('[data-livro]')?.getBoundingClientRect();
      const margem = 8;
      const limiteEsq = Math.max(margem, folha?.left ?? margem);
      const limiteDir = Math.min(window.innerWidth - margem, folha?.right ?? window.innerWidth - margem);
      const largura = Math.min(360, Math.max(0, limiteDir - limiteEsq));
      const espacoAcima = rect.top - margem;
      const espacoAbaixo = window.innerHeight - rect.bottom - margem;
      const intervalo = 8;

      balao.style.width = `${largura}px`;
      balao.style.maxHeight = '';
      balao.style.overflowY = '';
      const altura = balao.offsetHeight;
      let posicao: 'acima' | 'abaixo' = 'abaixo';
      let maxAltura = 0;

      if (espacoAbaixo >= altura + intervalo) {
        posicao = 'abaixo';
      } else if (espacoAcima >= altura + intervalo) {
        posicao = 'acima';
      } else {
        posicao = espacoAcima >= espacoAbaixo ? 'acima' : 'abaixo';
        maxAltura = Math.max(0, Math.max(espacoAcima, espacoAbaixo) - intervalo);
      }

      if (maxAltura) {
        balao.style.maxHeight = `${maxAltura}px`;
        balao.style.overflowY = 'auto';
      }

      const alturaFinal = balao.offsetHeight;
      const centro = rect.left + rect.width / 2;
      const esquerda = Math.min(
        Math.max(limiteEsq, centro - balao.offsetWidth / 2),
        Math.max(limiteEsq, limiteDir - balao.offsetWidth),
      );
      const topo = posicao === 'acima' ? rect.top - alturaFinal - intervalo : rect.bottom + intervalo;
      balao.dataset.posicao = posicao;
      balao.style.left = `${esquerda}px`;
      balao.style.top = `${Math.max(margem, topo)}px`;
      balao.style.setProperty('--seta-esquerda', `${Math.min(Math.max(centro - esquerda, 12), balao.offsetWidth - 12)}px`);
    };

    reposicionar();
    balao.querySelector<HTMLAnchorElement>('a')!.focus();

    const fechar = (devolverFoco = true) => {
      balao.remove();
      delete link.dataset.termoAberto;
      if (devolverFoco) link.focus();
      document.removeEventListener('keydown', tecla);
      document.removeEventListener('click', fora);
      window.removeEventListener('resize', reposicionar);
      window.visualViewport?.removeEventListener('resize', reposicionar);
      if (fecharBalaoAberto === fechar) fecharBalaoAberto = null;
    };
    fecharBalaoAberto = fechar;
    const tecla = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        fechar();
      }
    };
    const fora = (e: MouseEvent) => {
      if (!balao.contains(e.target as Node) && e.target !== link) fechar();
    };
    document.addEventListener('keydown', tecla);
    document.addEventListener('click', fora);
    window.addEventListener('resize', reposicionar);
    window.visualViewport?.addEventListener('resize', reposicionar);
  }, true);

  document.addEventListener('livro:virada', () => fecharBalaoAberto?.(false));
  document.addEventListener('astro:before-swap', () => fecharBalaoAberto?.(false));
</script>
