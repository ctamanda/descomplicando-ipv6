---
/**
 * Símbolo da logo (src/assets/logo/logo-icone.svg), desenhado inline para
 * acompanhar o tema: os traços usam --logo-traco (azul-marinho no claro,
 * branco no escuro) e o anel do selo usa --logo-anel (a cor do fundo onde
 * a logo está). Por padrão é decorativo; passe `rotulo` se estiver sozinho.
 */
interface Props {
  class?: string;
  rotulo?: string;
}
const { class: classe, rotulo } = Astro.props;
---
<svg
  class:list={['logo', classe]}
  viewBox="0 0 120 120"
  xmlns="http://www.w3.org/2000/svg"
  role={rotulo ? 'img' : undefined}
  aria-label={rotulo}
  aria-hidden={rotulo ? undefined : 'true'}
  focusable="false"
>
  <circle cx="56" cy="56" r="44" fill="none" stroke="var(--logo-traco)" stroke-width="7"></circle>
  <g fill="none" stroke="var(--logo-traco)" stroke-width="4" opacity="0.5">
    <ellipse cx="56" cy="56" rx="18" ry="44"></ellipse>
    <line x1="12" y1="56" x2="100" y2="56"></line>
    <path d="M18 34 Q56 46 94 34"></path>
    <path d="M18 78 Q56 66 94 78"></path>
  </g>
  <g stroke="var(--logo-traco)" stroke-width="4" fill="none" stroke-linecap="round">
    <line x1="30" y1="40" x2="62" y2="27"></line>
    <line x1="62" y1="27" x2="84" y2="44"></line>
    <line x1="30" y1="40" x2="42" y2="70"></line>
    <line x1="42" y1="70" x2="84" y2="44"></line>
  </g>
  <circle cx="62" cy="27" r="8" fill="#f2b705"></circle>
  <circle cx="30" cy="40" r="7" fill="#2fb36a"></circle>
  <circle cx="84" cy="44" r="7" fill="#2fb36a"></circle>
  <circle cx="42" cy="70" r="8" fill="#f2b705"></circle>
  <circle cx="88" cy="88" r="26" fill="#f2b705" stroke="var(--logo-anel)" stroke-width="5"></circle>
  <text x="88" y="97" text-anchor="middle" font-family="Fraunces, Georgia, serif" font-weight="600" font-size="26" fill="#123c6b">v6</text>
</svg>
