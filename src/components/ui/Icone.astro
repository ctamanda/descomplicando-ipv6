---
interface Props {
  nome: 'menu' | 'tema' | 'fechar' | 'anterior' | 'proxima' | 'recolher';
}
const { nome } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nome === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nome === 'tema' && <><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" /></>}
  {nome === 'fechar' && <path d="M6 6l12 12M18 6L6 18" />}
  {nome === 'anterior' && <path d="M15 5l-7 7 7 7" />}
  {nome === 'proxima' && <path d="M9 5l7 7-7 7" />}
  {nome === 'recolher' && <path d="M11 6l-6 6 6 6M19 6l-6 6 6 6" />}
</svg>
